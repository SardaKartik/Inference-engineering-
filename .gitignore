# Environment variables - never commit
.env


# =============================================================
# Benchmark results
# CSV and HTML files generated by Locust during test runs.
# These are local experiment outputs — not source code.
# Raw numbers go into docs/benchmarks.md manually after runs.
#
# The * ignores everything inside results/.
# The !.gitkeep line is a negation — it says "ignore everything
# EXCEPT .gitkeep". This keeps the folder tracked in Git so
# benchmark.sh can save CSVs there without a missing folder error.
# =============================================================
benchmarks/results/*
!benchmarks/results/.gitkeep


# =============================================================
# Docs — ignore binary files only
# The .md files in docs/ are committed — they are documentation.
# The PDF is a large binary reference file, not source code.
# =============================================================
docs/*.pdf


# =============================================================
# Python
# =============================================================

# Compiled bytecode — generated automatically by Python,
# not source code, regenerated on every run
__pycache__/
*.pyc
*.pyo

# Virtual environment — if one is ever created locally.
# Dependencies are installed directly on RunPod via setup.sh.
venv/
.venv/

# Jupyter notebook checkpoints
.ipynb_checkpoints/


# =============================================================
# Editor and OS files
# Personal editor settings and OS-generated files that have
# no meaning outside your own machine.
# =============================================================

# VS Code personal settings
.vscode/

# Mac OS metadata files
.DS_Store

# Windows thumbnail cache
Thumbs.db


# =============================================================
# Logs
# Any log files generated during runs
# =============================================================
*.log